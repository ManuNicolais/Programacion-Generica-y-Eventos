<Window x:Class="LienzoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lienzo de Dibujo" Height="450" Width="800">
    <Grid>
        <!-- Definir las filas del Grid -->
        <Grid.RowDefinitions>
            <!-- Fila para los controles -->
            <RowDefinition Height="Auto"/>
            <!-- Fila para el Canvas de dibujo -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Canvas para el dibujo -->
        <Canvas Name="Lienzo" Background="White" Grid.Row="1"
                MouseDown="Lienzo_MouseDown"
                MouseMove="Lienzo_MouseMove"
                MouseUp="Lienzo_MouseUp">
            <!-- Colocar el rectángulo detrás de los dibujos -->
            <Rectangle HorizontalAlignment="Center" Height="99" Stroke="Black" VerticalAlignment="Center" Width="800" Fill="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" Canvas.Top="-100"/>
        </Canvas>

        <!-- StackPanel para los controles, que está sobre el Canvas -->
        <StackPanel Name="ControlesPanel" Orientation="Vertical" Grid.Row="0" HorizontalAlignment="Left" Margin="10">
            <ComboBox Width="120" Text="Colores" SelectionChanged="ComboBox_SelectionChanged" Background="{DynamicResource {x:Static SystemColors.MenuHighlightBrushKey}}">
                <ComboBoxItem Content="Negro" Tag="Black" IsSelected="True"/>
                <ComboBoxItem Content="Rojo" Tag="Red"/>
                <ComboBoxItem Content="Verde" Tag="Green"/>
                <ComboBoxItem Content="Azul" Tag="Blue"/>
            </ComboBox>

            <Slider Name="GrosorSlider" Minimum="1" Maximum="10" Value="2" Width="120" ValueChanged="Slider_ValueChanged">
                <Slider.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="Black"/>
                        <GradientStop Color="#FF2D7ECD" Offset="1"/>
                    </RadialGradientBrush>
                </Slider.Background>
            </Slider>

            <Button Content="Borrador" Width="120" Click="ButtonBorrador_Click"/>
            <Button Content="Limpiar" Width="120" Click="ButtonLimpiar_Click"/>
        </StackPanel>

        <!-- Botón para esconder/mostrar los controles -->
        <Button Name="ToggleControlesButton" Content="Esconder Controles" Width="140" Height="30" HorizontalAlignment="Left" Margin="149,10,0,60" Click="ToggleControles_Click"/>
    </Grid>
</Window>
