<Window x:Class="Calculadora_En_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculadora_En_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="500">
    <Grid>
        <Button x:Name="btn1" Content="1" HorizontalAlignment="Left" Margin="10,217,0,0" VerticalAlignment="Top" Width="91" Height="107" Click="btn1_Click"/>
        <Button x:Name="btn2" Content="2" HorizontalAlignment="Left" Margin="107,217,0,0" VerticalAlignment="Top" Width="91" Height="107" Click="btn2_Click"/>
        <Button x:Name="btn3" Content="3" HorizontalAlignment="Center" Margin="0,217,0,0" VerticalAlignment="Top" Width="93" Height="107" Click="btn3_Click"/>
        <Button x:Name="btn4" Content="4" HorizontalAlignment="Left" Margin="10,331,0,0" VerticalAlignment="Top" Width="91" Height="106" Click="btn4_Click"/>
        <Button x:Name="btn5" Content="5" HorizontalAlignment="Left" Margin="107,331,0,0" VerticalAlignment="Top" Width="91" Height="106" Click="btn5_Click"/>
        <Button x:Name="btn6" Content="6" HorizontalAlignment="Center" Margin="0,331,0,0" VerticalAlignment="Top" Width="93" Height="106" Click="btn6_Click"/>
        <Button x:Name="btn7" Content="7" HorizontalAlignment="Left" Margin="10,445,0,0" VerticalAlignment="Top" Width="91" Height="106" Click="btn7_Click"/>
        <Button x:Name="btn8" Content="8" HorizontalAlignment="Left" Margin="107,445,0,0" VerticalAlignment="Top" Width="91" Height="106" Click="btn8_Click"/>
        <Button x:Name="btn9" Content="9" HorizontalAlignment="Center" Margin="0,445,0,0" VerticalAlignment="Top" Width="93" Height="106" Click="btn9_Click"/>
        <Button x:Name="btn0" Content="0" HorizontalAlignment="Left" Margin="107,559,0,0" VerticalAlignment="Top" Width="91" Height="106" Click="btn0_Click"/>

        <Button x:Name="btnSuma" Content="+" HorizontalAlignment="Left" Margin="302,217,0,0" VerticalAlignment="Top" Width="91" Height="107" Click="btnSuma_Click"/>
        <Button x:Name="btnResta" Content="-" HorizontalAlignment="Left" Margin="302,331,0,0" VerticalAlignment="Top" Width="91" Height="106" Click="btnResta_Click"/>
        <Button x:Name="btnMultiplicacion" Content="x" HorizontalAlignment="Left" Margin="302,445,0,0" VerticalAlignment="Top" Width="91" Height="106" Click="btnMultiplicacion_Click"/>
        <Button x:Name="btnDivision" Content="%" HorizontalAlignment="Left" Margin="302,559,0,0" VerticalAlignment="Top" Width="91" Height="106" Click="btnDivision_Click"/>
        <Button x:Name="btnIgual" Content="=" HorizontalAlignment="Left" Margin="400,217,0,0" VerticalAlignment="Top" Width="90" Height="107" Click="btnIgual_Click"/>
        <Button x:Name="btnBorrar" Content="AC" HorizontalAlignment="Left" Margin="400,331,0,0" VerticalAlignment="Top" Width="90" Height="106" Click="btnBorrar_Click"/>

        <TextBlock x:Name="Resultado" HorizontalAlignment="Center" Margin="0,100,0,0" VerticalAlignment="Top" Width="480" Height="93" FontSize="36"/>
    </Grid>
</Window>
